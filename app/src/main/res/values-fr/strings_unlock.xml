    <string name="unlock_pair_title">Télécommande de la TV</string>
    <string name="unlock_pair_gives">La télécommande elle-même : pavé, touches, clavier, voix et l’app à l’écran.</string>
    <string name="unlock_pair_how">1. Allumez la TV, sur le même Wi-Fi que ce téléphone.\n2. Dans tutti, trouvez la TV et choisissez-la.\n3. Saisissez le code affiché par la TV.</string>
    <string name="unlock_pair_action">Associer la TV</string>
    <string name="unlock_pair_again">Associer à nouveau</string>

    <string name="unlock_ip_title">Contrôle IP</string>
    <string name="unlock_ip_gives">Les réglages de la TV (image, sortie son, économie d’énergie), ce qui passe et sur quelle entrée, les apps de la TV et leurs icônes, et le réveil d’une TV complètement éteinte.</string>
    <string name="unlock_ip_how">Sur la TV, une fois : Paramètres › Réseau et Internet › Réseau domestique › Contrôle IP (le chemin du guide Sony). Activez-le, avec l’authentification « Normale » ou « Normale et clé pré-partagée ».\n\nPuis dans tutti, « Afficher un code sur la TV » et saisissez les 4 chiffres affichés par la TV. Une clé PSK fonctionne toujours si vous préférez.</string>
    <string name="unlock_ip_action">Afficher un code sur la TV</string>
    <string name="unlock_ip_change">Contrôle IP…</string>
    <string name="unlock_wake_ready">Réveil depuis l’arrêt : prêt.</string>
    <string name="unlock_wake_pending">Réveil depuis l’arrêt : tutti apprend l’adresse matérielle de la TV la prochaine fois qu’elle est allumée.</string>

    <string name="unlock_start_title">Démarrage à distance</string>
    <string name="unlock_start_gives">La TV reste joignable en veille, pour que Marche dans tutti puisse la réveiller.</string>
    <string name="unlock_start_how">Sur la TV : Paramètres → Réseau et Internet → Démarrage à distance : activé.\n\nLe réveil passe par le Wi-Fi : ce téléphone doit être sur le réseau de la TV. La TV consomme un peu plus en veille.</string>
    <string name="unlock_start_unknown">tutti le lit par le contrôle IP. D’ici là, vérifiez-le sur la TV.</string>
    <string name="unlock_start_recheck">Vérifier à nouveau</string>

    <string name="unlock_bar_title">Barre de son</string>
    <string name="unlock_bar_gives">Le rail de volume et la sourdine, le panneau Son (champ sonore, Voix, Nuit…), la barre dans les scènes, et un seul bouton Marche pour les deux.</string>
    <string name="unlock_bar_how">1. Dans BRAVIA Connect, activez Contrôle externe (External control) pour la barre.\n2. Notez l’adresse IP de la barre (BRAVIA Connect ou votre box l’affiche).\n3. Ajoutez la barre dans tutti avec cette adresse.</string>
    <string name="unlock_bar_action">Ajouter la barre de son</string>
    <string name="unlock_bar_again">Reconfigurer la barre</string>

    <string name="unlock_dev_title">Mode développeur</string>
    <string name="unlock_dev_gives">Diagnostic, détails techniques de chaque connexion, et Copier les détails sous les erreurs. L’app de tous les jours n’en a pas besoin.</string>
    <string name="unlock_dev_action">Activer le mode développeur</string>
    <string name="unlock_dev_off">Le désactiver</string>

    <string name="unlock_sony_title">Connexion Sony</string>
    <string name="unlock_sony_gives">Les réglages qui ne passent que par les serveurs de Sony. Pas encore dans tutti : rien à faire.</string>

