    <string name="gesture_power_long">Choisir ce qui s’éteint</string>
    <string name="gesture_power_long_detail">Appui long sur Power : la TV, la barre ou les deux, et la minuterie de veille de la TV.</string>
    <string name="gesture_now_showing_long">Actions de l’app</string>
    <string name="gesture_now_showing_long_detail">Appui long sur la carte « Sur la TV » : épingler l’app, ou fermer les apps de la TV.</string>
    <string name="gesture_pad_hold">Continuer d’avancer</string>
    <string name="gesture_pad_hold_detail">Laissez le doigt sur le pad après un glissé : le pas se répète.</string>
    <string name="gesture_pad_long">Maintenir OK</string>
    <string name="gesture_pad_long_detail">Gardez le doigt sur OK, ou immobile sur le touchpad : la TV reçoit OK maintenu, comme avec sa propre télécommande, et les apps ouvrent leurs options (sur YouTube, aller à la chaîne).</string>
    <string name="gesture_pad_two_tap">Lecture ou pause</string>
    <string name="gesture_pad_two_tap_detail">Touchez le pad avec deux doigts, en touchpad comme en D-pad.</string>
    <string name="gesture_pad_two_vertical">Volume de la barre</string>
    <string name="gesture_pad_two_vertical_detail">Glissez vers le haut ou le bas sur le pad avec deux doigts, en touchpad comme en D-pad.</string>
    <string name="gesture_volume_drag">Régler le volume</string>
    <string name="gesture_volume_drag_detail">Glissez n’importe où sur le rail de volume.</string>
    <string name="gesture_volume_hold">Continuer de monter</string>
    <string name="gesture_volume_hold_detail">Maintenez + ou − : le volume continue de changer.</string>
    <string name="gesture_volume_number">Niveau précis</string>
    <string name="gesture_volume_number_detail">Touchez le chiffre du rail de volume : niveau exact, niveaux enregistrés, plafond pour ce soir.</string>
    <string name="gesture_key_long">Votre propre action</string>
    <string name="gesture_key_long_detail">Appui long sur Accueil, Retour ou Lecture : l’action que vous lui avez donnée ; Lecture la demande la première fois.</string>
    <string name="gesture_mic_hold">Parler à la TV</string>
    <string name="gesture_mic_hold_detail">Maintenez la touche micro pendant que vous parlez, relâchez pour envoyer.</string>
    <string name="gesture_pin_long">Menu de l’épingle</string>
    <string name="gesture_pin_long_detail">Appui long sur une épingle : sa seconde action, puis Modifier.</string>
    <string name="gesture_dock_swipe">Page d’épingles suivante</string>
    <string name="gesture_dock_swipe_detail">Balayez le dock sur le côté dès qu’il a deux pages.</string>
    <string name="gesture_scene_long">Annuler, modifier ou épingler une scène</string>
    <string name="gesture_scene_long_detail">Appui long sur une scène du bandeau : annuler la dernière, la modifier ou l’épingler au dock.</string>
    <string name="gesture_bar_input_long">Menu de l’entrée</string>
    <string name="gesture_bar_input_long_detail">Appui long sur une entrée de la barre : la renommer, la masquer ou l’épingler au dock.</string>
    <string name="gesture_bluetooth_long">Associer un appareil</string>
    <string name="gesture_bluetooth_long_detail">Appui long sur Bluetooth dans Entrée de la barre : la barre attend un téléphone ou un casque.</string>
    <string name="gesture_effect_long">Épingler un effet</string>
    <string name="gesture_effect_long_detail">Appui long sur une tuile de son pour l’épingler au dock.</string>
    <string name="gesture_choice_long">Épingler un réglage</string>
    <string name="gesture_choice_long_detail">Appui long sur un choix DRC ou IMAX pour l’épingler au dock.</string>
    <string name="gesture_app_tile_long">Épingler une app</string>
    <string name="gesture_app_tile_long_detail">Appui long sur une app dans la feuille Apps.</string>
    <string name="gesture_all_keys_long">Épingler une touche</string>
    <string name="gesture_all_keys_long_detail">Appui long sur n’importe quelle touche de Toutes les touches pour l’épingler au dock.</string>
    <string name="gesture_tv_setting_long">Épingler un réglage TV</string>
    <string name="gesture_tv_setting_long_detail">Appui long sur un mode d’image ou une sortie son dans Réglages TV.</string>
    <string name="gesture_keyboard_swipe">Fermer le clavier</string>
    <string name="gesture_keyboard_swipe_detail">Balayez la vue clavier vers le bas.</string>
    <string name="gesture_launcher_long">Scènes depuis l’écran d’accueil</string>
    <string name="gesture_launcher_long_detail">Appui long sur l’icône tutti : vos scènes et le clavier, sans ouvrir la télécommande.</string>
    <string name="gesture_tile_long">Ouvrir tutti</string>
    <string name="gesture_tile_long_detail">Appui long sur la tuile des Réglages rapides.</string>

