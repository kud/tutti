    <string name="unlock_pair_title">TV remote</string>
    <string name="unlock_pair_gives">The remote itself: pad, keys, keyboard, voice and the app on screen.</string>
    <string name="unlock_pair_how">1. Turn the TV on, on the same Wi-Fi as this phone.\n2. In tutti, find the TV and pick it.\n3. Type the code the TV shows.</string>
    <string name="unlock_pair_action">Pair the TV</string>
    <string name="unlock_pair_again">Pair again</string>

    <string name="unlock_ip_title">IP control</string>
    <string name="unlock_ip_gives">TV settings (picture, sound output, power saving), what’s playing and on which input, the TV’s own apps and icons, and waking a TV that is fully off.</string>
    <string name="unlock_ip_how">On the TV, once: Settings › Network &amp; Internet › Home network › IP control (the path in Sony’s guide). Turn it on, with Authentication “Normal” or “Normal and Pre-Shared Key”.\n\nThen in tutti, “Show a code on the TV” and type the 4 digits the TV shows. A PSK still works if you prefer one.</string>
    <string name="unlock_ip_action">Show a code on the TV</string>
    <string name="unlock_ip_change">IP control…</string>
    <string name="unlock_wake_ready">Waking from off: ready.</string>
    <string name="unlock_wake_pending">Waking from off: tutti learns the TV’s hardware address the next time it is on.</string>

    <string name="unlock_start_title">Remote start</string>
    <string name="unlock_start_gives">The TV stays reachable in standby, so Power in tutti can wake it.</string>
    <string name="unlock_start_how">On the TV: Settings → Network &amp; Internet → Remote start: On.\n\nThe wake-up goes over Wi-Fi, so this phone must be on the TV’s network. The TV uses a little more power in standby.</string>
    <string name="unlock_start_unknown">tutti reads this through IP control. Until then, check it on the TV.</string>
    <string name="unlock_start_recheck">Check again</string>

    <string name="unlock_bar_title">Soundbar</string>
    <string name="unlock_bar_gives">The volume rail and mute, the Sound sheet (sound field, Voice, Night…), the bar in scenes, and one Power for both.</string>
    <string name="unlock_bar_how">1. In BRAVIA Connect, turn on External control for the bar.\n2. Note the bar’s IP address (BRAVIA Connect or your router shows it).\n3. Add the bar in tutti with that address.</string>
    <string name="unlock_bar_action">Add the soundbar</string>
    <string name="unlock_bar_again">Set up the bar again</string>

    <string name="unlock_dev_title">Developer mode</string>
    <string name="unlock_dev_gives">Diagnostics, technical details for each connection, and Copy details under errors. The everyday app doesn’t need it.</string>
    <string name="unlock_dev_action">Turn on developer mode</string>
    <string name="unlock_dev_off">Turn it off</string>

    <string name="unlock_sony_title">Sony sign-in</string>
    <string name="unlock_sony_gives">Settings that only go through Sony’s servers. Not in tutti yet: there is nothing to do.</string>

