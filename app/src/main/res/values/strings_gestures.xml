    <string name="gesture_power_long">Choose what turns off</string>
    <string name="gesture_power_long_detail">Long press Power: the TV, the soundbar or both, and the TV\'s sleep timer.</string>
    <string name="gesture_now_showing_long">App actions</string>
    <string name="gesture_now_showing_long_detail">Long press the On the TV card: pin the app, or close the TV\'s apps.</string>
    <string name="gesture_pad_hold">Keep moving</string>
    <string name="gesture_pad_hold_detail">Leave your finger on the pad after a swipe and the step repeats.</string>
    <string name="gesture_pad_long">Hold OK</string>
    <string name="gesture_pad_long_detail">Keep your finger on OK, or still on the touchpad: the TV gets OK held, as from its own remote, and apps open their options (on YouTube, go to the channel).</string>
    <string name="gesture_pad_two_tap">Play or pause</string>
    <string name="gesture_pad_two_tap_detail">Tap the pad with two fingers, touchpad or D-pad.</string>
    <string name="gesture_pad_two_vertical">Soundbar volume</string>
    <string name="gesture_pad_two_vertical_detail">Drag up or down on the pad with two fingers, touchpad or D-pad.</string>
    <string name="gesture_volume_drag">Set the volume</string>
    <string name="gesture_volume_drag_detail">Drag anywhere on the volume rail.</string>
    <string name="gesture_volume_hold">Keep turning</string>
    <string name="gesture_volume_hold_detail">Hold + or − and the volume keeps stepping.</string>
    <string name="gesture_volume_number">Exact level</string>
    <string name="gesture_volume_number_detail">Tap the number on the volume rail: an exact level, saved levels, a cap for tonight.</string>
    <string name="gesture_key_long">Your own action</string>
    <string name="gesture_key_long_detail">Long press Home, Back or Play: the action you gave it; Play asks for one the first time.</string>
    <string name="gesture_mic_hold">Speak to the TV</string>
    <string name="gesture_mic_hold_detail">Hold the mic key while you talk, let go to send.</string>
    <string name="gesture_pin_long">Pin menu</string>
    <string name="gesture_pin_long_detail">Long press a pin: its second action, then Edit.</string>
    <string name="gesture_dock_swipe">Next page of pins</string>
    <string name="gesture_dock_swipe_detail">Swipe the dock sideways once it has two pages.</string>
    <string name="gesture_scene_long">Undo, edit or pin a scene</string>
    <string name="gesture_scene_long_detail">Long press a scene in the strip: undo the last one, edit it, or pin it to the dock.</string>
    <string name="gesture_bar_input_long">Input menu</string>
    <string name="gesture_bar_input_long_detail">Long press a soundbar input: rename it, hide it or pin it to the dock.</string>
    <string name="gesture_bluetooth_long">Pair a device</string>
    <string name="gesture_bluetooth_long_detail">Long press Bluetooth in Bar input: the soundbar waits for a phone or headphones.</string>
    <string name="gesture_effect_long">Pin an effect</string>
    <string name="gesture_effect_long_detail">Long press a sound tile to pin it to the dock.</string>
    <string name="gesture_choice_long">Pin a setting</string>
    <string name="gesture_choice_long_detail">Long press a DRC or IMAX choice to pin it to the dock.</string>
    <string name="gesture_app_tile_long">Pin an app</string>
    <string name="gesture_app_tile_long_detail">Long press an app in the Apps sheet.</string>
    <string name="gesture_all_keys_long">Pin a key</string>
    <string name="gesture_all_keys_long_detail">Long press any key in All keys to pin it to the dock.</string>
    <string name="gesture_tv_setting_long">Pin a TV setting</string>
    <string name="gesture_tv_setting_long_detail">Long press a picture mode or sound output in TV settings.</string>
    <string name="gesture_keyboard_swipe">Close the keyboard</string>
    <string name="gesture_keyboard_swipe_detail">Swipe the keyboard view down.</string>
    <string name="gesture_launcher_long">Scenes from the home screen</string>
    <string name="gesture_launcher_long_detail">Long press the tutti icon: your scenes and the keyboard, without opening the remote first.</string>
    <string name="gesture_tile_long">Open tutti</string>
    <string name="gesture_tile_long_detail">Long press the Quick Settings tile.</string>

