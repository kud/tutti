<?xml version="1.0" encoding="utf-8"?>
<!-- Secrets (PSK, Sony tokens and session keys, pairing material) never leave the device.
     They live only in files/datastore/secure.preferences_pb and files/secure/, encrypted
     with an AndroidKeyStore key that is itself never backed up. The last crash trace
     (last_crash.txt) is stored unscrubbed, so it stays on the device too. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secure.preferences_pb" />
        <exclude domain="file" path="secure/" />
        <exclude domain="file" path="last_crash.txt" />
        <exclude domain="sharedpref" path="settings_sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secure.preferences_pb" />
        <exclude domain="file" path="secure/" />
        <exclude domain="file" path="last_crash.txt" />
        <exclude domain="sharedpref" path="settings_sync.xml" />
    </device-transfer>
</data-extraction-rules>
