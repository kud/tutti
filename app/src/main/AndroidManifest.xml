<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAN only: TCP to the bar, TLS to the TV, HTTP(S) REST, mDNS discovery. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Hold-to-talk to the TV's assistant: asked on first use, the mic is open only while held. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Bluetooth mode: the phone as the TV's keyboard and mouse (BluetoothHidDevice). CONNECT to
         register and send, ADVERTISE to be made visible for pairing; both asked on the Bluetooth
         screen, never at start. No SCAN: the TV finds the phone, not the other way round. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- The air-mouse pointer; the segment says so when there is none. -->
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <!-- ===== quick access: permissions (begin) ===== -->
    <!-- Control notification (Android 13+ runtime permission, asked from QuickNotificationSetting). No foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ===== quick access: permissions (end) ===== -->

    <!-- Lets "Recalibrer dans BRAVIA Connect" see whether Sony's app is installed. -->
    <!-- Launchable apps: an app tile with no TV icon borrows the icon of the same app on this
         phone (PhoneIconBitmaps), matched by exact package. A TV app outside the catalog has a
         package known only at run time, so per-package entries can't cover it; this is the narrow
         form, never QUERY_ALL_PACKAGES. tutti asks only about candidate packages, never lists. -->
    <queries>
        <package android:name="jp.co.sony.hes.home" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TuttiApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tutti">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Tutti.Starting"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ===== quick access: components (begin) — io.kud.tutti.quick ===== -->
        <!-- Long-press on the Quick Settings tile opens the app. Must follow .MainActivity. -->
        <activity-alias
            android:name=".quick.tile.QuickTilePreferences"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity-alias>

        <!-- Compact remote opened by the tile. Own empty affinity: never drags the main task along. -->
        <activity
            android:name=".quick.overlay.QuickOverlayActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/quick_OverlayTheme" />

        <!-- tutti://scene/<id> from an NFC tag or an automation app. No window; does nothing unless
             Settings › Automation is on. Never BROWSABLE: a web page cannot reach it. -->
        <activity
            android:name=".quick.automation.SceneTriggerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tutti" android:host="scene" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tutti" android:host="scene" />
            </intent-filter>
        </activity>

        <service
            android:name=".quick.tile.QuickTileService"
            android:exported="true"
            android:icon="@drawable/quick_ic_volume_up"
            android:label="@string/quick_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".quick.widget.QuickWidgetReceiver"
            android:exported="true"
            android:label="@string/quick_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_widget_info" />
        </receiver>

        <receiver
            android:name=".quick.notification.QuickNotificationReceiver"
            android:exported="false" />
        <!-- ===== quick access: components (end) ===== -->
    </application>
</manifest>
