<?xml version="1.0" encoding="utf-8"?>
<!-- The github build only: the in-app updater (docs/updates.md). The fdroid build has neither. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The in-app updater hands a verified APK to PackageInstaller; Android still asks to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- The in-app updater's install session reports here (platform/update). -->
        <receiver
            android:name=".platform.update.UpdateInstallReceiver"
            android:exported="false" />
        <!-- After an update the updater started: "tutti was updated", one tap back (platform/update).
             Not exported: MY_PACKAGE_REPLACED comes from the system, which reaches it anyway. -->
        <receiver
            android:name=".platform.update.UpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
